# App
APP_NAME="app"
APP_PORT="8080"
APP_ENV="development"
DEBUG="false"

# CORS: "*" reflects any origin, or a comma-separated allow-list
# e.g. CORS_ALLOW_ORIGINS="https://app.example.com,https://admin.example.com"
CORS_ALLOW_ORIGINS="*"

# Database
DB_HOST="localhost"
DB_PORT="5432"
DB_DATABASE="postgres"
DB_USER="postgres"
DB_PASSWORD="root"
DB_DSN=""
DB_SSLMODE="disable"
TZ="Asia/Bangkok"

# Auth (JWT)
TOKEN_SECRET_USER="change-me"
TOKEN_DURATION_USER="24h"

# Email (SMTP)
EMAIL_HOST=""
EMAIL_PORT=""
EMAIL_USERNAME=""
EMAIL_PASSWORD=""

# Google OAuth
REDIRECT_URL=""
CLIENT_ID=""
CLIENT_SECRET=""
